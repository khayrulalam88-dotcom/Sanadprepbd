rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'khayrulalam88@gmail.com') ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'question_manager' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'question_manager'])
      );
    }

    // Users collection (Users cannot escalate their own role or subscription status)
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAuthenticated() && request.auth.uid == userId && (request.resource.data.role == 'student' || isAdmin());
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == resource.data.subscriptionStatus)
      );
      allow delete: if isAdmin();
    }

    // Admin authorization collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Subjects collection (read by all, written by staff)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Exams collection
    match /exams/{examId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Exam attempts & results (user-owned)
    match /examAttempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /examResults/{resultId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Leaderboard collection (public merit list to foster healthy student competition)
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Payment requests (Students can only submit with status 'pending'; only Admin can approve/reject/update)
    match /paymentRequests/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid && 
        request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Subscriptions collection (Read-only for owner; STRICTLY written by Admin)
    match /subscriptions/{subscriptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Packages & Config
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
