rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // HELPER FUNCTIONS (Zero-Trust Attribute-Based Security)
    // ---------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Primary Owner Account: Cryptographically verified Khayrul Alam's email
    function isOwnerAccount() {
      return isAuthenticated() && 
             request.auth.token.email_verified == true && 
             request.auth.token.email == 'khayrulalam88@gmail.com';
    }

    // Admin Authority: Owner account OR verified entry in /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && (
        isOwnerAccount() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Verified Paid Access Gate: User must have active pro status AND unexpired subscription
    function hasActiveSubscription() {
      return isAuthenticated() && (
        isOwnerAccount() ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'pro' &&
          (
            !('subscriptionExpiresAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionExpiresAt == null ||
            string(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionExpiresAt) > string(request.time)
          )
        )
      );
    }

    // ---------------------------------------------------------
    // 1. ADMIN AUTHORIZATION RECORD (/admins/{adminId})
    // ---------------------------------------------------------
    // CRITICAL: Only the verified owner account can create, update, or revoke admin privileges.
    // Secondary admins or client-side requests CANNOT create other admins.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isOwnerAccount());
      allow write: if isOwnerAccount();
    }

    // ---------------------------------------------------------
    // 2. USER PROFILES (/users/{userId})
    // ---------------------------------------------------------
    // Ordinary students CANNOT grant themselves admin role or pro subscription status.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        isOwnerAccount() || (
          request.resource.data.role == 'student' && 
          request.resource.data.subscriptionStatus == 'free' &&
          (!('subscriptionExpiresAt' in request.resource.data) || request.resource.data.subscriptionExpiresAt == null)
        )
      );
      allow update: if isOwnerAccount() || (
        isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      ) || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 
          'subscriptionStatus', 
          'subscriptionExpiresAt', 
          'activePackageId', 
          'activePackageNameBn', 
          'activePackageNameEn'
        ])
      );
      allow delete: if isOwnerAccount();
    }

    // ---------------------------------------------------------
    // 3. PAYMENT REQUESTS (/paymentRequests/{paymentId})
    // ---------------------------------------------------------
    // Students can ONLY create requests with status 'pending' for their own UID.
    // Document ID MUST match trx_{transactionId} to prevent duplicate transaction IDs across all accounts.
    // Only the authorized Admin/Owner can approve, reject, or update requests.
    match /paymentRequests/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid && 
        request.resource.data.status == 'pending' &&
        request.resource.data.verifiedAt == null &&
        request.resource.data.verifiedBy == null &&
        request.resource.data.subscriptionId == null &&
        request.resource.data.transactionId is string &&
        request.resource.data.transactionId.size() >= 4 &&
        paymentId == ('trx_' + request.resource.data.transactionId) &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if isOwnerAccount() || isAdmin();
      allow delete: if isOwnerAccount();
    }

    // ---------------------------------------------------------
    // 4. SUBSCRIPTIONS (/subscriptions/{subscriptionId})
    // ---------------------------------------------------------
    // Strictly created and managed by the Admin/Owner upon manual payment approval.
    // Students can ONLY read their own subscription document.
    match /subscriptions/{subscriptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update: if isOwnerAccount() || isAdmin();
      allow delete: if isOwnerAccount();
    }

    // ---------------------------------------------------------
    // 5. EXAMINATIONS (/exams/{examId})
    // ---------------------------------------------------------
    // Free exams readable by all; Paid 60-min model tests require active Pro subscription or Admin.
    match /exams/{examId} {
      allow read: if resource.data.isPaid == false || hasActiveSubscription();
      allow write: if isOwnerAccount() || isAdmin();
    }

    // ---------------------------------------------------------
    // 6. QUESTION BANK & SYLLABUS
    // ---------------------------------------------------------
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isOwnerAccount() || isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isOwnerAccount() || isAdmin();
    }

    match /previous_questions/{questionId} {
      allow read: if true;
      allow write: if isOwnerAccount() || isAdmin();
    }

    // ---------------------------------------------------------
    // 7. EXAM ATTEMPTS & RESULTS
    // ---------------------------------------------------------
    match /examAttempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if (isOwner(resource.data.userId) && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isOwnerAccount() || isAdmin();
    }

    match /examResults/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.score is number &&
                    request.resource.data.totalQuestions is number &&
                    request.resource.data.totalQuestions <= 200 &&
                    request.resource.data.score <= request.resource.data.totalQuestions &&
                    request.resource.data.score >= -50;
      allow update: if isOwnerAccount() || isAdmin();
      allow delete: if isOwnerAccount() || isAdmin();
    }

    // ---------------------------------------------------------
    // 8. LEADERBOARD (Public merit list)
    // ---------------------------------------------------------
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.score is number &&
                    request.resource.data.score >= -50 &&
                    request.resource.data.score <= 100;
      allow update: if isOwnerAccount() || (
        isOwner(resource.data.userId) && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.score is number &&
        request.resource.data.score <= 100
      );
      allow delete: if isOwnerAccount() || isAdmin();
    }

    // ---------------------------------------------------------
    // 9. PACKAGES, CONFIG & AUDIT LOGS
    // ---------------------------------------------------------
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isOwnerAccount() || isAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isOwnerAccount() || isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isOwnerAccount();
    }
  }
}
