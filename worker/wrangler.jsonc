{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "s--khayrul-alam-worker-staging",
  "main": "./index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanad-prep-edge-db-staging",
      "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "FIREBASE_PROJECT_ID": "sanad-prep-bd-staging",
    "FIREBASE_DATABASE_ID": "(default)",
    "STAGING_OWNER_ADMIN_UID": "REPLACE_WITH_STAGING_OWNER_UID",
    "QUESTION_BANK_CACHE_TTL_MS": "3600000",
    "ALLOWED_ORIGIN": "https://s--khayrul-alam-worker-staging.khayrulalam88.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
