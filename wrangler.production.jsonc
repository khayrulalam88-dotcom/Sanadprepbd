{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "s--khayrul-alam",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanad-prep-edge-db-production",
      "database_id": "81bce5d2-fb29-4d2a-9542-cc3b7465fa39",
      "migrations_dir": "./worker/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "FIREBASE_PROJECT_ID": "galvanic-aviary-tzp2g",
    "FIREBASE_DATABASE_ID": "ai-studio-barcouncilmcqpre-9a5aecc8-3819-4aeb-b7e2-c6066b637cab",
    "QUESTION_BANK_CACHE_TTL_MS": "3600000",
    "ALLOWED_ORIGIN": "https://s--khayrul-alam.khayrulalam88.workers.dev,https://sanadprepbd.com,https://www.sanadprepbd.com"
  },
  "observability": {
    "enabled": true
  }
}
